# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for the agent exploration loop (fast, cheap, frequent calls)
AGENT_MODEL=gemini-2.5-flash

# Model used for the one-shot architecture synthesis (stronger reasoning)
SYNTH_MODEL=gemini-2.5-pro

# Backend port
PORT=8787
