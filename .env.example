# Which LLM backend to use: "gemini" (default) or "openrouter"
LLM_PROVIDER=gemini

# --- Gemini (LLM_PROVIDER=gemini) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- OpenRouter (LLM_PROVIDER=openrouter) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model overrides (optional). Defaults depend on the provider:
#   gemini     -> agent: gemini-2.5-flash        synth: gemini-2.5-pro
#   openrouter -> agent: google/gemini-2.5-flash synth: anthropic/claude-sonnet-4-6
AGENT_MODEL=
SYNTH_MODEL=

# Backend port
PORT=8787

# Hard cap on agent tool-calling iterations (cost guard)
MAX_AGENT_STEPS=25
